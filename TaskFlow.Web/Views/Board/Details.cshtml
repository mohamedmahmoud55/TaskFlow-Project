@model TaskFlow.Web.Models.Boards.BoardDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="container-fluid py-4">

    <!-- Breadcrumbs -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Project"
                   asp-action="Details"
                   asp-route-id="@Model.ProjectId">
                    @Model.ProjectName
                </a>
            </li>
            <li class="breadcrumb-item active">
                @Model.Name
            </li>
        </ol>
    </nav>

    <!-- Board Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2">
                <h2 class="fw-bold mb-0">@Model.Name</h2>

                @if (Model.IsDefault)
                {
                    <span class="badge bg-primary">Default</span>
                }
            </div>

            <p class="text-muted mt-2 mb-0">
                @(Model.Description ?? "Manage your project tasks and workflow.")
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Board"
               asp-action="Index"
               asp-route-projectId="@Model.ProjectId"
               asp-route-teamId="@Model.TeamId"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> All Boards
            </a>
        </div>

    </div>

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Add Column -->
    @if (Model.CanManage)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">Add a Column</h5>

                <form asp-controller="Board"
                      asp-action="CreateColumn"
                      asp-route-boardId="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="row g-3 align-items-end">

                        <div class="col-md-4">
                            <label class="form-label">Column Name</label>
                            <input name="Name"
                                   class="form-control"
                                   maxlength="100"
                                   required
                                   placeholder="e.g. Review" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">WIP Limit</label>
                            <input name="WipLimit"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="Optional" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Description</label>
                            <input name="Description"
                                   class="form-control"
                                   maxlength="500"
                                   placeholder="Optional" />
                        </div>

                        <div class="col-md-2">
                            <button type="submit"
                                    class="btn btn-primary w-100">
                                <i class="bi bi-plus-lg"></i> Add Column
                            </button>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    }

    <!-- Kanban Columns -->
    <div class="row g-3">

        @if (Model.Columns.Count == 0)
        {
            <div class="col-12">
                <div class="alert alert-info">
                    No columns are available on this board yet.
                </div>
            </div>
        }
        else
        {
            @foreach (var column in Model.Columns.OrderBy(c => c.Position))
            {
                <div class="col-12 col-md-6 col-xl-4">

                    <div class="card border-0 shadow-sm h-100">

                        <!-- Column Header -->
                        <div class="card-header bg-white border-bottom py-3">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <h5 class="fw-bold mb-1">
                                        @column.Name

                                        @if (column.IsDefault)
                                        {
                                            <span class="badge bg-secondary">
                                                Default
                                            </span>
                                        }

                                        @if (column.IsCompleted)
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                    </h5>

                                    <small class="text-muted">
                                        @(column.Description ?? "No description")
                                    </small>
                                </div>

                                @if (column.WipLimit.HasValue)
                                {
                                    <span class="badge bg-warning text-dark">
                                        WIP: @column.WipLimit
                                    </span>
                                }

                            </div>

                        </div>

                     <!-- Tasks Area -->
<div class="card-body bg-light">

    @{
        var columnTasks = Model.TasksByColumn.TryGetValue(
            column.Id,
            out var tasks)
            ? tasks
            : Array.Empty<TaskFlow.Services.Tasks.Models.TaskListItem>();
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-muted small">
            @columnTasks.Count task(s)
        </span>

        <a asp-controller="Task"
           asp-action="Create"
           asp-route-boardColumnId="@column.Id"
           class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg"></i> Add Task
        </a>
    </div>

    @if (columnTasks.Count == 0)
    {
        <div class="text-center py-4">
            <i class="bi bi-inbox display-5 text-muted"></i>
            <p class="text-muted mt-2 mb-0">
                No tasks in this column yet.
            </p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var task in columnTasks.OrderBy(t => t.Position))
            {
                <div class="card border shadow-sm">
                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-start">
                            <h6 class="fw-semibold mb-2">
                                <a asp-controller="Task"
                                   asp-action="Details"
                                   asp-route-id="@task.Id"
                                   class="text-decoration-none text-dark">
                                    @task.Title
                                </a>
                            </h6>

                            @if (task.IsCompleted)
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                        </div>

                        <div class="mb-2">
                            <span class="badge bg-secondary">
                                @task.Priority
                            </span>
                        </div>

                        @if (task.DueDate.HasValue)
                        {
                            <small class="text-muted">
                                <i class="bi bi-calendar-event"></i>
                                Due: @task.DueDate.Value.ToShortDateString()
                            </small>
                        }

                        <div class="d-flex gap-2 mt-3">
                            <a asp-controller="Task"
                               asp-action="Edit"
                               asp-route-id="@task.Id"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            <form asp-controller="Task"
                                  asp-action="Archive"
                                  asp-route-id="@task.Id"
                                  method="post">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-warning">
                                    Archive
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>

                        <!-- Edit Column -->
                        @if (Model.CanManage)
                        {
                            <div class="card-footer bg-white">

                                <details>
                                    <summary class="text-primary"
                                             style="cursor:pointer">
                                        <i class="bi bi-pencil"></i>
                                        Edit Column
                                    </summary>

                                    <form asp-controller="Board"
                                          asp-action="UpdateColumn"
                                          asp-route-boardId="@Model.Id"
                                          method="post"
                                          class="mt-3">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="BoardId"
                                               value="@Model.Id" />

                                        <input type="hidden"
                                               name="ColumnId"
                                               value="@column.Id" />

                                        <div class="mb-2">
                                            <label class="form-label">
                                                Column Name
                                            </label>

                                            <input name="Name"
                                                   value="@column.Name"
                                                   class="form-control"
                                                   maxlength="100"
                                                   required />
                                        </div>

                                        <div class="mb-2">
                                            <label class="form-label">
                                                Description
                                            </label>

                                            <input name="Description"
                                                   value="@column.Description"
                                                   class="form-control"
                                                   maxlength="500" />
                                        </div>

                                        <div class="mb-2">
                                            <label class="form-label">
                                                WIP Limit
                                            </label>

                                            <input name="WipLimit"
                                                   type="number"
                                                   min="1"
                                                   value="@column.WipLimit"
                                                   class="form-control" />
                                        </div>

                                        <!-- Completed Column -->
                                       <div class="form-check mb-3">

    <input name="IsCompleted"
           type="checkbox"
           value="true"
           class="form-check-input"
           checked="@column.IsCompleted" />

    <input name="IsCompleted"
           type="hidden"
           value="false" />

    <label class="form-check-label">
        Completed column
    </label>

</div>

                                        <button type="submit"
                                                class="btn btn-primary btn-sm">
                                            Save Changes
                                        </button>

                                    </form>
                                </details>

                            </div>
                        }

                    </div>
                </div>
            }
        }

    </div>

</div>