@model TaskFlow.Web.Models.Boards.CreateBoardViewModel

@{
    ViewData["Title"] = "Create Board";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="mb-4">
                <h2 class="fw-bold">Create a Board</h2>
                <p class="text-muted">
                    Create a workspace for organizing your project tasks.
                </p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    <form asp-controller="Board"
                          asp-action="Create"
                          asp-route-projectId="@Model.ProjectId"
                          asp-route-teamId="@Model.TeamId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"></div>

                        <input type="hidden" asp-for="ProjectId" />
                        <input type="hidden" asp-for="TeamId" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="e.g. Development Board" />
                            <span asp-validation-for="Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description"
                                   class="form-label fw-semibold"></label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe the purpose of this board..."></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="IsDefault"
                                   class="form-check-input" />
                            <label asp-for="IsDefault"
                                   class="form-check-label"></label>
                            <div class="form-text">
                                The default board is the primary board for this project.
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Board"
                               asp-action="Index"
                               asp-route-projectId="@Model.ProjectId"
                               asp-route-teamId="@Model.TeamId"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit" class="btn btn-primary">
                                Create Board
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}