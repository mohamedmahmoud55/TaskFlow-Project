@model TaskFlow.Web.Models.Boards.BoardListViewModel

@{
    ViewData["Title"] = "Boards";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Boards</h2>
            <p class="text-muted mb-0">
                Project: @Model.ProjectName
            </p>
        </div>

        <a asp-controller="Board"
           asp-action="Create"
           asp-route-projectId="@Model.ProjectId"
           asp-route-teamId="@Model.TeamId"
           class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Create Board
        </a>
    </div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Boards.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center p-5">
            <div class="mb-3">
                <i class="bi bi-kanban display-3 text-primary"></i>
            </div>

            <h4>No boards yet</h4>

            <p class="text-muted">
                Create your first board to start organizing project tasks.
            </p>

            <div>
                <a asp-controller="Board"
                   asp-action="Create"
                   asp-route-projectId="@Model.ProjectId"
                   asp-route-teamId="@Model.TeamId"
                   class="btn btn-primary">
                    Create your first board
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var board in Model.Boards)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="fw-bold mb-0">
                                    @board.Name
                                </h5>

                                @if (board.IsDefault)
                                {
                                    <span class="badge bg-primary">
                                        Default
                                    </span>
                                }
                            </div>

                            <p class="text-muted">
                                @(string.IsNullOrWhiteSpace(board.Description)
                                    ? "No description provided."
                                    : board.Description)
                            </p>

                            <div class="d-flex justify-content-between text-muted small mb-3">
                                <span>
                                    <i class="bi bi-columns-gap"></i>
                                    @board.ColumnCount columns
                                </span>

                                <span>
                                    @board.CreatedAt.ToString("MMM dd, yyyy")
                                </span>
                            </div>

                            <a asp-controller="Board"
                               asp-action="Details"
                               asp-route-id="@board.Id"
                               asp-route-projectId="@Model.ProjectId"
                               class="btn btn-outline-primary w-100">
                                Open Board
                            </a>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

    <div class="mt-4">
        <a asp-controller="Project"
           asp-action="Details"
           asp-route-id="@Model.ProjectId"
           class="btn btn-outline-secondary">
            Back to Project
        </a>
    </div>

</div>