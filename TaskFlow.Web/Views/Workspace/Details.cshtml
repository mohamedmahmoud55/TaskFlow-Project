@model TaskFlow.Web.Models.WorkspaceDetailsViewModel
@using TaskFlow.Data.Enums
@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none">&larr; My Workspaces</a>
        <h1 class="h2 mt-2 mb-1">@Model.Name</h1>
        <p class="text-muted mb-0">
            @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
        </p>
    </div>
    <span class="badge text-bg-primary fs-6">@Model.CurrentUserRole</span>
</div>

@if (Model.CanEditWorkspace)
{
    <!-- Workspace settings -->
    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i>
            Edit workspace
        </a>

        @if (Model.CanArchiveWorkspace)
        {
            <form asp-action="Archive"
                  method="post"
                  class="ms-auto"
                  onsubmit="return confirm('Archive this workspace? Its teams, projects, boards and tasks will be hidden for everyone until you restore it from My Workspaces.');">

                @Html.AntiForgeryToken()

                <input type="hidden" name="WorkspaceId" value="@Model.Id" />

                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-archive me-1"></i>
                    Archive
                </button>
            </form>
        }
    </div>
}

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-12 col-md-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5">Teams</h2>
                <p class="text-muted">Organize people and projects into teams.</p>
                <a asp-controller="Team" asp-action="Index" asp-route-workspaceId="@Model.Id" class="btn btn-outline-primary">View teams</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5">Projects</h2>
                <p class="text-muted">See every project you can open, across all your workspaces.</p>
                <a asp-controller="Project" asp-action="MyProjects" class="btn btn-outline-primary">My Projects</a>
            </div>
        </div>
    </div>
</div>

<!-- Workspace Members -->
<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="h5 mb-0">
                    <i class="bi bi-people me-2"></i>
                    Workspace Members
                </h2>
                <small class="text-muted">
                    People who belong to this workspace.
                </small>
            </div>

            <span class="badge text-bg-secondary">
                @Model.Members.Count(member => member.IsActive) members
            </span>
        </div>
    </div>

    <div class="card-body">

        @if (Model.CanManageMembers)
        {
            <!-- Add Member Form -->
            <div class="border rounded p-3 mb-4">
                <h3 class="h6 mb-3">
                    <i class="bi bi-person-plus me-1"></i>
                    Add Workspace Member
                </h3>

                <form asp-controller="Workspace"
                      asp-action="AddMember"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="WorkspaceId" value="@Model.Id" />

                    <div class="row g-3 align-items-end">
                        <div class="col-md-6">
                            <label for="workspaceMemberEmail" class="form-label">
                                Member Email
                            </label>

                            <input type="email"
                                   id="workspaceMemberEmail"
                                   name="Email"
                                   class="form-control"
                                   placeholder="user@example.com"
                                   required />
                        </div>

                        <div class="col-md-4">
                            <label for="workspaceMemberRole" class="form-label">
                                Workspace Role
                            </label>

                            <select id="workspaceMemberRole"
                                    name="Role"
                                    class="form-select">
                                @foreach (var role in Model.AssignableRoles)
                                {
                                    <option value="@((int)role)" selected="@(role == WorkspaceRole.Member)">
                                        @role
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-plus-lg me-1"></i>
                                Add
                            </button>
                        </div>
                    </div>

                    <small class="text-muted d-block mt-2">
                        The user must already have a TaskFlow account.
                        Adding a deactivated member again will reactivate their membership.
                    </small>
                </form>
            </div>
        }

        @if (Model.Members.Count == 0)
        {
            <div class="text-center py-4">
                <i class="bi bi-people display-5 text-muted"></i>
                <p class="text-muted mt-2 mb-0">
                    No workspace members found.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Member</th>
                            <th>Role</th>
                            <th>Status</th>

                            @if (Model.CanManageMembers)
                            {
                                <th class="text-end">Actions</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var member in Model.Members)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">
                                        @member.DisplayName
                                        @if (member.IsCurrentUser)
                                        {
                                            <span class="badge text-bg-light border ms-1">You</span>
                                        }
                                    </div>
                                    <small class="text-muted">
                                        @member.Email
                                    </small>
                                </td>

                                <td>
                                    @member.Role
                                </td>

                                <td>
                                    @if (member.IsActive)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Inactive</span>
                                    }
                                </td>

                                @if (Model.CanManageMembers)
                                {
                                    <td>
                                        @if (member.CanManage)
                                        {
                                            <div class="d-flex justify-content-end flex-wrap gap-2">

                                                <!-- Update Role -->
                                                <form asp-controller="Workspace"
                                                      asp-action="UpdateMemberRole"
                                                      method="post"
                                                      class="d-flex gap-2">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="WorkspaceId" value="@Model.Id" />
                                                    <input type="hidden" name="MembershipId" value="@member.Id" />

                                                    <select name="Role"
                                                            class="form-select form-select-sm"
                                                            aria-label="Member role">
                                                        @foreach (var role in Model.AssignableRoles)
                                                        {
                                                            <option value="@((int)role)" selected="@(member.Role == role)">
                                                                @role
                                                            </option>
                                                        }
                                                    </select>

                                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                                        Save
                                                    </button>
                                                </form>

                                                <!-- Deactivate Member -->
                                                <form asp-controller="Workspace"
                                                      asp-action="DeactivateMember"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to deactivate this member?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="WorkspaceId" value="@Model.Id" />
                                                    <input type="hidden" name="MembershipId" value="@member.Id" />

                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-person-x me-1"></i>
                                                        Deactivate
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else if (!member.IsActive)
                                        {
                                            <span class="text-muted small">
                                                Add this member again to reactivate.
                                            </span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <small class="text-muted d-block mt-3">
                Deactivating someone here removes them from the workspace only.
                Teams and projects they were added to stay as they are.
            </small>
        }

    </div>
</div>
