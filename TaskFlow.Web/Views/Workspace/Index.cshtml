@model TaskFlow.Web.Models.WorkspaceListViewModel
@{
    ViewData["Title"] = "My Workspaces";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">My Workspaces</h1>
        <p class="text-muted mb-0">Workspaces where you are an active member.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create workspace</a>
</div>

@if (Model.Workspaces.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <h2 class="h4">No workspaces yet</h2>
            <p class="text-muted">Create your first workspace to start organizing your work.</p>
            <a asp-action="Create" class="btn btn-primary">Create workspace</a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var workspace in Model.Workspaces)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 card-title">@workspace.Name</h2>
                        <p class="card-text text-muted flex-grow-1">
                            @(string.IsNullOrWhiteSpace(workspace.Description) ? "No description provided." : workspace.Description)
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge text-bg-secondary">@workspace.Role</span>
                            <a asp-action="Details" asp-route-id="@workspace.Id" class="btn btn-outline-primary btn-sm">Open</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
