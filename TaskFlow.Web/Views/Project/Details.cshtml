@model TaskFlow.Web.Models.ProjectDetailsViewModel
@using TaskFlow.Data.Enums

@{
    ViewData["Title"] = Model.Name;
}

<div class="mb-4">
    <!-- Breadcrumbs -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item">
                <a asp-controller="Workspace"
                   asp-action="Index">
                    My Workspaces
                </a>
            </li>

            <li class="breadcrumb-item">
                <a asp-controller="Workspace"
                   asp-action="Details"
                   asp-route-id="@Model.WorkspaceId">
                    @Model.WorkspaceName
                </a>
            </li>

            <li class="breadcrumb-item">
                <a asp-controller="Team"
                   asp-action="Details"
                   asp-route-id="@Model.TeamId"
                   asp-route-workspaceId="@Model.WorkspaceId">
                    @Model.TeamName
                </a>
            </li>

            <li class="breadcrumb-item active" aria-current="page">
                @Model.Name
            </li>
        </ol>
    </nav>

    <!-- Project Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
            <h1 class="h2 mb-1">@Model.Name</h1>

            <p class="text-muted mb-0">
                @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "No description provided."
                    : Model.Description)
            </p>
        </div>

        <div class="d-flex gap-2">
            <span class="badge text-bg-secondary fs-6">
                @Model.Status
            </span>

            @if (Model.CurrentUserRole is not null)
            {
                <span class="badge text-bg-primary fs-6">
                    @Model.CurrentUserRole
                </span>
            }
            else if (Model.CanManageMembers)
            {
                <span class="badge text-bg-success fs-6">
                    Workspace Admin
                </span>
            }
        </div>
    </div>
</div>

<!-- Success / Error Messages -->
@if (TempData["Success"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"
                aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"
                aria-label="Close"></button>
    </div>
}

<!-- Project Boards -->
<div class="card shadow-sm mb-4">
    <div class="card-body py-5 text-center">
        <div class="mb-3">
            <i class="bi bi-kanban display-3 text-primary"></i>
        </div>

        <h2 class="h4 mb-2">
            Project Boards
        </h2>

        <p class="text-muted mb-4">
            Organize your project workflow using boards and Kanban columns.
            Manage your team's work in one place.
        </p>

        <div class="d-flex justify-content-center flex-wrap gap-2">
            <a asp-controller="Board"
               asp-action="Index"
               asp-route-projectId="@Model.Id"
               asp-route-teamId="@Model.TeamId"
               class="btn btn-primary">
                <i class="bi bi-kanban me-1"></i>
                View Project Boards
            </a>

            <a asp-controller="Team"
               asp-action="Details"
               asp-route-id="@Model.TeamId"
               asp-route-workspaceId="@Model.WorkspaceId"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Team
            </a>
        </div>
    </div>
</div>

<!-- Project Members -->
<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="h5 mb-0">
                    <i class="bi bi-people me-2"></i>
                    Project Members
                </h2>
                <small class="text-muted">
                    Manage people who have access to this project.
                </small>
            </div>

            <span class="badge text-bg-secondary">
                @Model.Members.Count members
            </span>
        </div>
    </div>

    <div class="card-body">

        @if (Model.CanManageMembers)
        {
            <!-- Add Member Form -->
            <div class="border rounded p-3 mb-4">
                <h3 class="h6 mb-3">
                    <i class="bi bi-person-plus me-1"></i>
                    Add Project Member
                </h3>

                <form asp-controller="Project"
                      asp-action="AddMember"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="ProjectId" value="@Model.Id" />

                    <div class="row g-3 align-items-end">
                        <div class="col-md-6">
                            <label for="memberEmail" class="form-label">
                                Member Email
                            </label>

                            <input type="email"
                                   id="memberEmail"
                                   name="Email"
                                   class="form-control"
                                   placeholder="user@example.com"
                                   required />
                        </div>

                        <div class="col-md-4">
                            <label for="memberRole" class="form-label">
                                Project Role
                            </label>

                            <select id="memberRole"
                                    name="Role"
                                    class="form-select">
                                <option value="@((int)ProjectRole.Member)" selected>
                                    Member
                                </option>
                                <option value="@((int)ProjectRole.Manager)">
                                    Manager
                                </option>
                                <option value="@((int)ProjectRole.Viewer)">
                                    Viewer
                                </option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-plus-lg me-1"></i>
                                Add
                            </button>
                        </div>
                    </div>

                    <small class="text-muted d-block mt-2">
                        The user must already have a TaskFlow account.
                        Adding an inactive member again will reactivate their membership.
                    </small>
                </form>
            </div>
        }

        <!-- Members List -->
        @if (Model.Members.Count == 0)
        {
            <div class="text-center py-4">
                <i class="bi bi-people display-5 text-muted"></i>
                <p class="text-muted mt-2 mb-0">
                    No project members found.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Member</th>
                            <th>Role</th>
                            <th>Status</th>

                            @if (Model.CanManageMembers)
                            {
                                <th class="text-end">Actions</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var member in Model.Members)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">
                                        @member.DisplayName
                                    </div>
                                    <small class="text-muted">
                                        @member.Email
                                    </small>
                                </td>

                                <td>
                                    @member.Role
                                </td>

                                <td>
                                    @if (member.IsActive)
                                    {
                                        <span class="badge text-bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                @if (Model.CanManageMembers)
                                {
                                    <td>
                                        @if (member.IsActive)
                                        {
                                            <div class="d-flex justify-content-end flex-wrap gap-2">

                                                <!-- Update Role -->
                                                <form asp-controller="Project"
                                                      asp-action="UpdateMemberRole"
                                                      method="post"
                                                      class="d-flex gap-2">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="ProjectId"
                                                           value="@Model.Id" />

                                                    <input type="hidden"
                                                           name="MembershipId"
                                                           value="@member.Id" />

                                                    <select name="Role"
                                                            class="form-select form-select-sm"
                                                            aria-label="Member role">

                                                        @foreach (ProjectRole role in Enum.GetValues(typeof(ProjectRole)))
                                                        {
                                                            <option value="@((int)role)"
                                                                    selected="@(member.Role == role)">
                                                                @role
                                                            </option>
                                                        }
                                                    </select>

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-primary">
                                                        Save
                                                    </button>
                                                </form>

                                                <!-- Deactivate Member -->
                                                <form asp-controller="Project"
                                                      asp-action="DeactivateMember"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to deactivate this member?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="ProjectId"
                                                           value="@Model.Id" />

                                                    <input type="hidden"
                                                           name="MembershipId"
                                                           value="@member.Id" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-person-x me-1"></i>
                                                        Deactivate
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                Add this member again to reactivate.
                                            </span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>
