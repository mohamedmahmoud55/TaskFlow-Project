@model TaskFlow.Web.Models.ProjectListViewModel
@{
    ViewData["Title"] = "Projects";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Workspace" asp-action="Index">My Workspaces</a></li>
                <li class="breadcrumb-item"><a asp-controller="Workspace" asp-action="Details" asp-route-id="@Model.WorkspaceId">@Model.WorkspaceName</a></li>
                <li class="breadcrumb-item"><a asp-controller="Team" asp-action="Details" asp-route-id="@Model.TeamId" asp-route-workspaceId="@Model.WorkspaceId">@Model.TeamName</a></li>
                <li class="breadcrumb-item active" aria-current="page">Projects</li>
            </ol>
        </nav>
        <h1 class="h2 mb-1">Projects</h1>
        <p class="text-muted mb-0">Projects in @Model.TeamName.</p>
    </div>
    <a asp-action="Create" asp-route-teamId="@Model.TeamId" asp-route-workspaceId="@Model.WorkspaceId" class="btn btn-primary">Create project</a>
</div>

@if (Model.Projects.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <h2 class="h4">No projects yet</h2>
            <p class="text-muted">Create a project to start planning work for this team.</p>
            <a asp-action="Create" asp-route-teamId="@Model.TeamId" asp-route-workspaceId="@Model.WorkspaceId" class="btn btn-primary">Create project</a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var project in Model.Projects)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5">@project.Name</h2>
                        <p class="text-muted flex-grow-1">
                            @(string.IsNullOrWhiteSpace(project.Description) ? "No description provided." : project.Description)
                        </p>
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <span class="badge text-bg-secondary">@project.Status</span>
                            <a asp-action="Details" asp-route-id="@project.Id" asp-route-teamId="@Model.TeamId" class="btn btn-outline-primary btn-sm">Open</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
