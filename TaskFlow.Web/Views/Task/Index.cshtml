@model TaskFlow.Web.Models.Tasks.TaskListViewModel

@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.ColumnName) ? "Tasks" : $"{Model.ColumnName} - Tasks";
}

<div class="container mt-4">
    @await Component.InvokeAsync("Breadcrumbs", new { boardColumnId = Model.BoardColumnId, current = "Tasks" })

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h2 mb-1">@(string.IsNullOrWhiteSpace(Model.ColumnName) ? "Tasks" : Model.ColumnName)</h1>
            @if (!string.IsNullOrWhiteSpace(Model.BoardName))
            {
                <p class="text-muted mb-0">Board: @Model.BoardName</p>
            }
        </div>

        <div class="d-flex gap-2">
            @if (Model.BoardId != Guid.Empty)
            {
                <a asp-controller="Board"
                   asp-action="Details"
                   asp-route-id="@Model.BoardId"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-kanban me-1"></i> Back to Board
                </a>
            }

            @if (Model.CanCreateTasks)
            {
                <a asp-action="Create"
                   asp-route-boardColumnId="@Model.BoardColumnId"
                   class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> Create Task
                </a>
            }
        </div>
    </div>

    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Tasks.Count == 0)
    {
        <div class="alert alert-info">
            No tasks found in this column yet.
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var task in Model.Tasks)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h2 class="h5 mb-1">
                                <a asp-action="Details"
                                   asp-route-id="@task.Id"
                                   class="text-decoration-none">
                                    @task.Title
                                </a>
                            </h2>

                            <small class="text-muted">
                                Priority: @task.Priority
                                @if (task.DueDate.HasValue)
                                {
                                    <span>
                                        | Due: @task.DueDate.Value.ToShortDateString()
                                    </span>
                                }
                            </small>
                        </div>

                        <div class="d-flex gap-2 align-items-center">
                            @if (task.IsCompleted)
                            {
                                <span class="badge bg-success">Completed</span>
                            }

                            @if (task.CanEdit)
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@task.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <form asp-action="Archive"
                                      asp-route-id="@task.Id"
                                      method="post"
                                      onsubmit="return confirm('Archive this task?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-warning">
                                        Archive
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
