@model TaskFlow.Web.Models.Tasks.TaskListViewModel

@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.ColumnName) ? "Tasks" : $"{Model.ColumnName} - Tasks";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Tasks</h2>
        <a asp-action="Create"
           asp-route-boardColumnId="@Context.Request.Query["boardColumnId"]"
           class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Create Task
        </a>
    </div>

    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Tasks.Count == 0)
    {
        <div class="alert alert-info">
            No tasks found in this column yet.
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var task in Model.Tasks)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h2 class="h5 mb-1">
                                <a asp-action="Details"
                                   asp-route-id="@task.Id"
                                   class="text-decoration-none">
                                    @task.Title
                                </a>
                            </h2>

                            <small class="text-muted">
                                Priority: @task.Priority
                                @if (task.DueDate.HasValue)
                                {
                                    <span>
                                        | Due: @task.DueDate.Value.ToShortDateString()
                                    </span>
                                }
                            </small>
                        </div>

                        <div class="d-flex gap-2 align-items-center">
                            @if (task.IsCompleted)
                            {
                                <span class="badge bg-success">Completed</span>
                            }

                            @if (task.CanEdit)
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@task.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                            <form asp-action="Archive"
                                  asp-route-id="@task.Id"
                                  method="post">
                                <button type="submit"
                                        class="btn btn-sm btn-outline-warning">
                                    Archive
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
