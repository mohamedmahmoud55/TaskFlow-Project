@model TaskFlow.Web.Models.TeamListViewModel
@{
    ViewData["Title"] = "Teams";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Workspace" asp-action="Index">My Workspaces</a></li>
                <li class="breadcrumb-item"><a asp-controller="Workspace" asp-action="Details" asp-route-id="@Model.WorkspaceId">@Model.WorkspaceName</a></li>
                <li class="breadcrumb-item active" aria-current="page">Teams</li>
            </ol>
        </nav>
        <h1 class="h2 mb-1">Teams</h1>
        <p class="text-muted mb-0">Teams in @Model.WorkspaceName.</p>
    </div>
    <a asp-action="Create" asp-route-workspaceId="@Model.WorkspaceId" class="btn btn-primary">Create team</a>
</div>

@if (Model.Teams.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <h2 class="h4">No teams yet</h2>
            <p class="text-muted">Create a team to organize people and projects in this workspace.</p>
            <a asp-action="Create" asp-route-workspaceId="@Model.WorkspaceId" class="btn btn-primary">Create team</a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var team in Model.Teams)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5">@team.Name</h2>
                        <p class="text-muted flex-grow-1">
                            @(string.IsNullOrWhiteSpace(team.Description) ? "No description provided." : team.Description)
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            @if (team.CurrentUserRole is not null)
                            {
                                <span class="badge text-bg-secondary">@team.CurrentUserRole</span>
                            }
                            <a asp-action="Details" asp-route-id="@team.Id" asp-route-workspaceId="@Model.WorkspaceId" class="btn btn-outline-primary btn-sm">Open</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
